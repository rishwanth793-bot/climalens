res.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\n/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \'react\';\nimport { VerificationProvider, useVerification } from \'./context/VerificationContext\';\nimport { DemoModeBanner } from \'./components/DemoModeBanner\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { Header } from \'./components/Header\';\nimport { SourcePanelModal } from \'./components/SourcePanelModal\';\nimport { AdjustValueModal } from \'./components/AdjustValueModal\';\nimport { ContextualPDFModal } from \'./components/ContextualPDFModal\';\nimport { GeminiRegulatoryAssistant } from \'./components/GeminiRegulatoryAssistant\';\n\n// Pages\nimport { OverviewPage } from \'./pages/OverviewPage\';\nimport { UploadPage } from \'./pages/UploadPage\';\nimport { ExtractionPage } from \'./pages/ExtractionPage\';\nimport { DataReviewPage } from \'./pages/DataReviewPage\';\nimport { VerificationCenterPage } from \'./pages/VerificationCenterPage\';\nimport { EnvironmentalContextPage } from \'./pages/EnvironmentalContextPage\';\nimport { HistoricalAnalysisPage } from \'./pages/HistoricalAnalysisPage\';\nimport { FlagInvestigationPage } from \'./pages/FlagInvestigationPage\';\nimport { FinalReportPage } from \'./pages/FinalReportPage\';\nimport { ReportHistoryPage } from \'./pages/ReportHistoryPage\';\nimport { SettingsPage } from \'./pages/SettingsPage\';\n\nconst MainLayout: React.FC = () => {\n  const { activeView, toastMessage } = useVerification();\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  const renderActiveView = () => {\n    switch (activeView) {\n      case \'overview\':\n        return <OverviewPage />;\n      case \'upload\':\n        return <UploadPage />;\n      case \'extraction\':\n        return <ExtractionPage />;\n      case \'review\':\n        return <DataReviewPage />;\n      case \'verification\':\n        return <VerificationCenterPage />;\n      case \'environmental-context\':\n        return <EnvironmentalContextPage />;\n      case \'historical\':\n        return <HistoricalAnalysisPage />;\n      case \'flags\':\n        return <FlagInvestigationPage />;\n      case \'final-report\':\n        return <FinalReportPage />;\n      case \'report-history\':\n        return <ReportHistoryPage />;\n      case \'settings\':\n        return <SettingsPage />;\n      default:\n        return <OverviewPage />;\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 flex flex-col font-sans antialiased\">\n      {/* Top Demo Mode Banner */}\n      <DemoModeBanner />\n\n      <div className=\"flex-1 flex\">\n        {/* Sidebar */}\n        <Sidebar\n          isOpenMobile={mobileMenuOpen}\n          setIsOpenMobile={setMobileMenuOpen}\n        />\n\n        {/* Main Content Area */}\n        <div className=\"flex-1 flex flex-col min-w-0 lg:pl-64\">\n          <Header onToggleMobileMenu={() => setMobileMenuOpen(!mobileMenuOpen)} />\n\n          <main className=\"flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto\">\n            {renderActiveView()}\n          </main>\n        </div>\n      </div>\n\n      {/* Floating Modals */}\n      <SourcePanelModal />\n      <AdjustValueModal />\n      <ContextualPDFModal />\n      <GeminiRegulatoryAssistant />\n\n      {/* Toast Notification */}\n      {toastMessage && (\n        <div className=\"fixed bottom-5 right-5 z-50 animate-in fade-in slide-in-from-bottom-3 duration-200\">\n          <div className=\"bg-slate-900 text-white text-xs font-medium px-4 py-3 rounded-xl border border-slate-700 shadow-xl flex items-center gap-2.5\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n            <span>{toastMessage}</span>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default function App() {\n  return (\n    <VerificationProvider>\n      <MainLayout />\n    </VerificationProvider>\n  );\n}\n\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \'IBM Plex Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  --font-display: \'Barlow\', \'IBM Plex Sans\', sans-serif;\n  --font-industrial: \'Barlow\', \'IBM Plex Sans\', sans-serif;\n  --font-mono: \'JetBrains Mono\', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n}\n\n:root {\n  color-scheme: light;\n}\n\nbody {\n  font-family: var(--font-sans);\n  background-color: #F8FAFC;\n  color: #0F172A;\n  overflow-x: hidden;\n  letter-spacing: -0.01em;\n}\n\n/* Industrial typography for major headings and command titles */\nh1, h2, h3 {\n  font-family: var(--font-display);\n  letter-spacing: -0.025em;\n}\n\n.font-industrial {\n  font-family: var(--font-display);\n}\n\n.font-mono-data {\n  font-family: var(--font-mono);\n  font-feature-settings: \"zero\" 1, \"tnum\" 1;\n}\n\n/* Custom sleek scrollbar for clean white/slate industrial dashboard */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: #F1F5F9;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #CBD5E1;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #94A3B8;\n}\n\n/* Tabular numerals for high-precision environmental metrics */\n.tabular-nums {\n  font-variant-numeric: tabular-nums;\n  font-feature-settings: \"tnum\" 1;\n}\n\n/* Glassmorphism accents in light theme */\n.glass-panel {\n  background: rgba(255, 255, 255, 0.88);\n  backdrop-filter: blur(12px);\n  border: 1px solid rgba(226, 232, 240, 0.85);\n}\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {StrictMode} from \'react\';\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(\n  <StrictMode>\n    <App />\n  </StrictMode>,\n);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"types\": [\"vite/client\"],\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  }\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\342\200\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
